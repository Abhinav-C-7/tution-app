generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =================================================================
// MULTI-TENANCY MODELS
// =================================================================
model Tenant {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  // Add other tenant-specific settings here, like subscription status, etc.
  createdAt DateTime @default(now())

  // Relations
  users       UserTenantRole[]
  batches     Batch[]
  students    Student[]
  feeRequests FeeRequest[]
  studentFees StudentFee[]
  payments    Payment[]
  attendances Attendance[]
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  clerkId   String   @unique
  createdAt DateTime @default(now())

  // Relations
  tenants UserTenantRole[]
}

model UserTenantRole {
  userId   Int
  tenantId Int
  role     String // e.g., 'ADMIN', 'TUTOR', 'VIEWER'

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId])
}

// =================================================================

model Batch {
  id           Int      @id @default(autoincrement())
  name         String
  admissionFee Int?     @default(0)
  subjects     String?
  schedule     String?
  createdAt    DateTime @default(now())

  // Multi-tenancy
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Relations
  students    Student[]
  feeRequests FeeRequest[]
  payments    Payment[]
  attendance  Attendance[]
}

model Student {
  id          Int       @id @default(autoincrement())
  name        String
  phone       String?
  parentName  String
  parentPhone String
  dob         DateTime?
  joinedAt    DateTime  @default(now())
  discount    Int       @default(0)

  batchId Int
  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  // Multi-tenancy
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Relations
  feeRecords  StudentFee[]
  payments    Payment[]
  attendances Attendance[]
}

model FeeRequest {
  id        Int      @id @default(autoincrement())
  name      String
  amount    Int
  dueDate   DateTime
  createdAt DateTime @default(now())

  batchId Int
  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  // Multi-tenancy
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Links
  studentFees StudentFee[]
  payments    Payment[]
}

model StudentFee {
  id         Int     @id @default(autoincrement())
  status     String  @default("Pending")
  amountPaid Int     @default(0)
  remarks    String?

  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  feeRequestId Int
  feeRequest   FeeRequest @relation(fields: [feeRequestId], references: [id], onDelete: Cascade)

  // Multi-tenancy
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([studentId, feeRequestId])
}

model Payment {
  id      Int      @id @default(autoincrement())
  amount  Int
  date    DateTime @default(now())
  remarks String?

  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  batchId Int
  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  feeRequestId Int
  feeRequest   FeeRequest? @relation(fields: [feeRequestId], references: [id])

  // Multi-tenancy
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Attendance {
  id     Int      @id @default(autoincrement())
  date   DateTime @default(now())
  status String

  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  batchId Int
  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  // Multi-tenancy
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([batchId, date])
}
