generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Batch {
  id   Int    @id @default(autoincrement())
  name String

  // "defaultFee" acts as a template. When you create a new cycle, 
  // you can pre-fill the amount input with this value.
  defaultFee   Int? @default(0)
  admissionFee Int? @default(0)

  subjects       String?
  schedule       String?
  billingCycle   String? // 'MONTHLY', 'QUARTERLY', 'ONE_TIME', 'CUSTOM'
  customDuration Int? // In months
  createdAt      DateTime @default(now())

  // Relations
  students   Student[]
  feeCycles  FeeCycle[] // 👈 Tracks history of all fee requests (Jan, Feb...)
  payments   Payment[]
  attendance Attendance[]
}

model Student {
  id          Int       @id @default(autoincrement())
  name        String
  phone       String?
  parentName  String
  parentPhone String
  dob         DateTime?
  joinedAt    DateTime  @default(now())

  // Note: Global discount. Can be applied when generating a new FeeCycle.
  discount Int @default(0)

  batchId Int
  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  // Relations
  feeRecords  StudentFee[] // 👈 History of status (Jan: Paid, Feb: Pending)
  payments    Payment[]
  attendances Attendance[]
}

// ---------------------------------------------------------
// NEW: Represents a "Bill" or "Request" (e.g., January 2026)
// ---------------------------------------------------------
model FeeCycle {
  id        Int      @id @default(autoincrement())
  name      String // e.g. "January Fees" or "Exam Fees"
  amount    Int // The standard amount for this cycle
  dueDate   DateTime
  createdAt DateTime @default(now())

  batchId Int
  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  // Links
  studentFees StudentFee[] // The specific status of every student for this cycle
  payments    Payment[] // Optional: Know which cycle a payment belongs to
}

// ---------------------------------------------------------
// NEW: Represents the Status of ONE student for ONE cycle
// ---------------------------------------------------------
model StudentFee {
  id         Int     @id @default(autoincrement())
  status     String  @default("Pending") // 'Pending', 'Paid', 'Partial'
  amountPaid Int     @default(0) // Helpful if they pay in 2 installments
  remarks    String? // e.g. "Late fee waived"

  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  feeCycleId Int
  feeCycle   FeeCycle @relation(fields: [feeCycleId], references: [id], onDelete: Cascade)

  @@unique([studentId, feeCycleId]) // Prevent duplicate records for same student/cycle
}

model Payment {
  id      Int      @id @default(autoincrement())
  amount  Int
  date    DateTime @default(now())
  remarks String? // e.g., 'Cash', 'UPI'

  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  batchId Int
  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  // Optional: If you want to link a payment explicitly to "January Fees"
  feeCycleId Int?
  feeCycle   FeeCycle? @relation(fields: [feeCycleId], references: [id])
}

model Attendance {
  id     Int      @id @default(autoincrement())
  date   DateTime @default(now())
  status String // 'Present', 'Absent', 'Late'

  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  batchId Int
  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, date])
}
